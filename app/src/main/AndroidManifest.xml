<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Three small permissions, and no internet access: a launcher gets the list of apps from Android
         itself. config/allowed-permissions.txt keeps it that way. -->

    <!-- The status line's [wifi] / [mobile]: whether the phone is on Wi-Fi or mobile data.
         It can't open connections or see what's sent; the app still has no internet. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Today's events under the date. Only asked for after you tap "Yes" on the offer, and
         only read on the phone: with no internet permission, events can't be sent anywhere.
         Read only; the launcher can't add, change or delete events. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- The prompt's `timer` and `alarm` commands: asks the clock app to start a timer or
         set an alarm. Granted on install; it can't read or change existing alarms. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lets the app see apps that can be opened from a home screen, and nothing else
         (instead of the much broader "see every installed app" permission). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewtHome">

        <!-- The home screen. HOME lets it be chosen under Settings → Apps → Default apps →
             Home app; LAUNCHER also lists it in other launchers, for trying it out first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
