<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A few small permissions, and no internet access: a launcher gets the list of apps from Android
         itself. config/allowed-permissions.txt keeps it that way. -->

    <!-- The status line's [wifi] / [mobile]: whether the phone is on Wi-Fi or mobile data.
         It can't open connections or see what's sent; the app still has no internet. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Today's events under the date. Only asked for after you tap "Yes" on the offer, and
         only read on the phone: with no internet permission, events can't be sent anywhere.
         Read only; the launcher can't add, change or delete events. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- The prompt's `timer` and `alarm` commands: asks the clock app to start a timer or
         set an alarm. Granted on install; it can't read or change existing alarms. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- "2 missed" under Phone: how many missed calls Newt Phone says you haven't seen, and
         nothing else. Newt Phone only grants this to apps signed with the Newt key, so no
         call history is ever shared and nobody is asked. -->
    <uses-permission android:name="io.github.secnewt.dialer.permission.MISSED_CALL_COUNT" />

    <!-- The weather by the date: temperatures, conditions and active warnings from Newt Weather,
         which does the fetching. Newt Weather grants this only to apps signed with the Newt key;
         nobody is asked, no ZIP or place is shared, and Newt Home still has no internet. -->
    <uses-permission android:name="io.github.secnewt.weather.permission.READ_FORECAST" />

    <!-- Lets the default home app see Private space, so its apps can have their own locked
         section in All apps. Android only grants it to the default home app; nobody is asked,
         and it shows nothing while Private space is locked. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Lets the app see apps that can be opened from a home screen, and nothing else
         (instead of the much broader "see every installed app" permission). -->
    <queries>
        <!-- Lets "Hear the weather" find the phone's text-to-speech voice (no permission). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Newt Phone's missed-call count (see above), and no other app's data. -->
        <provider android:authorities="io.github.secnewt.dialer.missedcalls" />
        <!-- Newt Weather's forecast (see above), and no other app's data. -->
        <provider android:authorities="io.github.secnewt.weather.forecast" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewtHome">

        <!-- The home screen. HOME lets it be chosen under Settings → Apps → Default apps →
             Home app; LAUNCHER also lists it in other launchers, for trying it out first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Add to home screen" from a browser or another app: asks before adding the
             shortcut. Android only sends these to the default home app. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NewtHome.Sheet">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
